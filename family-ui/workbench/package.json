{
  "name": "hypershell-ui-workbench",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build --output-dir storybook-static && python3 scripts/externalize_storybook_inline.py",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook-light --browser.fileParallelism=false && vitest run --project storybook-dark --browser.fileParallelism=false",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "check:catalog": "python3 scripts/check_catalog.py",
    "check:mcp-docs": "node scripts/check_mcp_docs.mjs",
    "check:mcp-auth": "node scripts/check_mcp_server.mjs",
    "check:foundation": "pnpm run lint && pnpm run test:unit && pnpm run build && pnpm run build:storybook && pnpm run check:catalog",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.18.1",
    "react-router": "^8.5.1",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/mcp": "10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@storybook/test": "^8.6.15",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "oxlint": "^1.90.0",
    "storybook": "^10.6.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
